[Unit]
Description=DAMA Lite - essai TEMPORAIRE de chauffe sous surveillance locale
After=dama-lite-staging.service
Requires=dama-lite-staging.service
Conflicts=dama-lite.service

[Service]
Type=simple
User=damocles
Group=damocles
SupplementaryGroups=gpio
WorkingDirectory=/home/damocles/dama-lite-staging
Environment=PYTHONPATH=/home/damocles/dama-lite-staging/backend
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/python3 -m dama_lite.heating_onsite_test --preflight --config /home/damocles/dama-lite-staging/config.staging.json
ExecStart=/usr/bin/python3 -m dama_lite.heating_onsite_test --run --duration-s 600 --config /home/damocles/dama-lite-staging/config.staging.json
# Systématiquement forcer le niveau LOW si Python échoue / termine /
# est arrêté par systemd. Le relais est supposé actif HIGH.
ExecStopPost=/usr/bin/pinctrl set 21 op pd dl
Restart=no
RuntimeMaxSec=630
TimeoutStopSec=8
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
# Ne pas activer au boot ; pas de WantedBy.
